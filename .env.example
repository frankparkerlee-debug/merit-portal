# ───────────────────────────────────────────────────────────────
# Merit Portal — environment template
#
# Copy to `.env` for local dev. In production these are set in
# Render → Service → Environment.
# Never commit `.env` to git.
# ───────────────────────────────────────────────────────────────

# Postgres connection string (Render gives you this on the DB dashboard)
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"        # local
# NEXTAUTH_URL="https://portal.meritsciences.com"  # production

# Postmark — for magic-link emails + transactional notifications
# Get from postmarkapp.com → Servers → API tokens
POSTMARK_API_KEY=""
POSTMARK_FROM_EMAIL="no-reply@meritsciences.com"

# Shopify Admin API — used by the webhook handler and to push status updates
SHOPIFY_SHOP_DOMAIN="meritpeptides.myshopify.com"
SHOPIFY_ADMIN_TOKEN=""                       # custom-app token
SHOPIFY_WEBHOOK_SECRET=""                    # for verifying incoming webhooks

# AWS S3 — encrypted file storage for ID photos, lab PDFs, prescription PDFs
# Bucket must have versioning + server-side encryption + lifecycle rules
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="merit-portal-phi"

# Twilio (optional, for SMS) — only enable in HIPAA migration phase
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Operating mode
NODE_ENV="development"
PORTAL_ENV="dev"                             # dev | staging | prod
